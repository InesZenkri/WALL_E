# Copy to brain/.env and fill in. Never commit .env.

# OpenRouter API key (the variable name is historical)
OPENAI_API_KEY=your-openrouter-key-here
OPENAI_MODEL=openai/gpt-4o
MAX_TOKENS=10000

# Robot REST API (use http://localhost:8081 with brain/mock_robot.py)
# URL=http://192.168.24.82:8081

# Optional hardening, off when unset
# BRAIN_API_KEY=choose-a-long-random-string
# MAX_MOVE_METERS=5
